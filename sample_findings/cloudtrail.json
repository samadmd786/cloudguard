    "Title": "CloudTrail.1 CloudTrail should be enabled and configured with at least one multi-Region trail",
    "Description": "This control checks that there is at least one multi-region AWS CloudTrail trail. CloudTrail records API calls for your account and delivers log files to you. Without CloudTrail enabled, you have no audit history of who made what API calls to your AWS environment, making forensic investigation and compliance auditing impossible.",
    "Resources": [
        {
            "Type": "AwsAccount",
            "Id": "arn:aws:cloudtrail:us-east-1:123456789012:trail/management-events",
            "Partition": "aws",
            "Region": "us-east-1",
            "Details": {
                "AwsCloudTrailTrail": {
                    "Name": "management-events",
                    "IsMultiRegionTrail": false,
                    "IsLogging": false,
                    "HomeRegion": "us-east-1"
                }
            }
        }
    ],
    "Compliance": {
        "Status": "FAILED",
        "RelatedRequirements": [
